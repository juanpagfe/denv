#!/bin/bash

USER_BIN="$HOME/.local/bin"
SYSTEM_BIN="/usr/local/bin"

SYSTEM_TOOLS=(
    copy
    aimgr
    imgctl
    port
    proc
    space
    trash
    dupe
    netwatch
    pack
    tunnel
)

in_array() {
    local value=$1
    shift

    for item; do
        [[ "$item" == "$value" ]] && return 0
    done

    return 1
}

if [ ! -d ~/.config ]; then
    mkdir ~/.config
fi

echo "Installing for Linux..."
cp -rf linux/.config/* ~/.config

echo "Installing common..."
cp -rf common/.config/* ~/.config
cp rc/.* ~/


#Copy bin
if [ ! -d ~/.local/bin ]; then
    mkdir -p ~/.local/bin
fi

cp -f common/.local/bin/* ~/.local/bin

#Build and install compiled tools
if echo "$@" | grep -q -- "--skip-tools"; then
    echo "Skipping compiled tools (--skip-tools)"
else
    if [ -f tools/build.sh ]; then
        echo "Building compiled tools..."
        bash tools/build.sh
        if [ -d tools/bin ]; then
            cp -f tools/bin/* ~/.local/bin/
            echo "Compiled tools installed"
        fi
    fi
fi

for tool in ~/.local/bin/*; do
    name=$(basename "$tool")
    if in_array "$name" "${SYSTEM_TOOLS[@]}"; then
        sudo cp ~/.local/bin/$name /usr/local/bin
    fi
done

#Merge environment files
if [ ! -f envrc ]; then
    echo "Generating envrc file"
    if [ -f /tmp/envrc ]; then
        sudo rm /tmp/envrc
    fi
    touch /tmp/envrc
    cat env/*.sh > /tmp/envrc
fi

#Install environment files
if [ -f envrc ]; then
    sudo mv envrc /etc/envrc
else
    sudo mv /tmp/envrc /etc/envrc
fi
echo "Installation completed"
