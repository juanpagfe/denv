#!/bin/bash

if [ ! -d ~/.config ]; then
    mkdir ~/.config
fi

echo "Installing for Linux..."
cp -rf linux/.config/* ~/.config

echo "Installing common..."
cp -rf common/.config/* ~/.config
cp rc/.* ~/


#Copy bin
if [ ! -d ~/.local/bin ]; then
    mkdir -p ~/.local/bin
fi

cp -f common/.local/bin/* ~/.local/bin

#Build and install compiled tools
if echo "$@" | grep -q -- "--skip-tools"; then
    echo "Skipping compiled tools (--skip-tools)"
else
    if [ -f tools/build.sh ]; then
        echo "Building compiled tools..."
        bash tools/build.sh
        if [ -d tools/bin ]; then
            cp -f tools/bin/* ~/.local/bin/
            echo "Compiled tools installed"
        fi
    fi
fi

#Merge environment files
if [ ! -f envrc ]; then
    echo "Generating envrc file"
    if [ -f /tmp/envrc ]; then
        sudo rm /tmp/envrc
    fi
    touch /tmp/envrc
    cat env/*.sh > /tmp/envrc
fi

#Install environment files
if [ -f envrc ]; then
    sudo mv envrc /etc/envrc
else
    sudo mv /tmp/envrc /etc/envrc
fi
echo "Installation completed"
