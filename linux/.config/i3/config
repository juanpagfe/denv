# i3 config file (v4)
# See http://i3wm.org/docs/userguide.html for a complete reference

# Set the Mod key to the Windows (Super) key.
set $mod Mod4
floating_modifier $mod
focus_follows_mouse no

# Set the font for window titles and i3bar.
font pango:Meslo LGM Nerd Font 11px

# Remove borders from windows and set custom border size and color for focused windows.
for_window [class="^.*"] border pixel 1
client.focused #77dd77 #285577 #ffffff #2e9ef4 #285577

# Launch desktop files with dex for XDG autostart compatibility.
exec --no-startup-id dex --autostart --environment i3

# Use xss-lock to handle screen locking before suspend.
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock -e --color 000000 --show-failed-attempts --nofork

# Start system tray applets and load Xresources.
exec --no-startup-id volumeicon
exec --no-startup-id dunst
exec --no-startup-id xrdb -merge ~/.Xresources

for_window [window_role="pop-up"] floating enable
for_window [window_type="dialog"] floating enable
for_window [class="gnome-calculator"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [class="Blueman-manager"] floating enable

set $term wezterm start --always-new-process
bindsym $mod+Return exec --no-startup-id $term

# Close the focused window with $mod+Shift+q.
bindsym $mod+Shift+q kill

# Launch Rofi application launcher with $mod+d.
bindsym $mod+d exec --no-startup-id rofi -show drun -show-icons
bindsym $mod+s exec --no-startup-id ~/.config/i3/dmenu-pkexec.sh

# Change focus between containers using $mod+h/j/k/l.
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Change focus with arrow keys as an alternative.
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window between containers using $mod+Shift+h/j/k/l.
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Move focused window with arrow keys as an alternative.
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split the container in horizontal or vertical orientation.
bindsym $mod+z split h
bindsym $mod+v split v

# Toggle fullscreen mode for the focused container.
bindsym $mod+f fullscreen toggle

# Change container layout to stacking, tabbed, or toggle split.
#bindsym $mod+s layout stacking
#bindsym $mod+w layout tabbed
#bindsym $mod+e layout toggle split

# Toggle between tiling and floating for the focused container.
bindsym $mod+Shift+space floating toggle

# Focus on the parent container.
bindsym $mod+a focus parent

# Workspace management shortcuts.
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

# Move focused container to a specific workspace.
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

# Reload configuration with $mod+Shift+c.
bindsym $mod+Shift+c reload

# Restart i3 inplace with $mod+Shift+r.
bindsym $mod+Shift+r restart

# Enter "resize" mode with $mod+r.
mode "resize" {
        bindsym h resize shrink width 5 px or 5 ppt
        bindsym j resize grow height 5 px or 5 ppt
        bindsym k resize shrink height 5 px or 5 ppt
        bindsym l resize grow width 5 px or 5 ppt
        bindsym Left resize shrink width 5 px or 5 ppt
        bindsym Down resize grow height 5 px or 5 ppt
        bindsym Up resize shrink height 5 px or 5 ppt
        bindsym Right resize grow width 5 px or 5 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

bar {
    position top

    status_command sh -c 'if [ -f "$HOME/.config/py3status/modules/rovo.cfg" ]; then . "$HOME/.config/py3status/modules/rovo.cfg"; fi; exec py3status'

    tray_output primary

    font pango:Meslo LGM Nerd Font 9

    separator_symbol "│"

    colors {
        background          #181825
        statusline           #cdd6f4
        separator            #6B6E8A

        focused_workspace    #89b4fa #89b4fa #1e1e2e
        active_workspace     #313244 #313244 #cdd6f4
        inactive_workspace   #181825 #181825 #6c7086
        urgent_workspace     #f38ba8 #f38ba8 #1e1e2e
        binding_mode         #f9e2af #f9e2af #1e1e2e
    }
}

exec --no-startup-id nm-applet      # Network manager tray icon
exec --no-startup-id blueman-applet # Bluetooth manager tray icon
exec --no-startup-id /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1

bindsym $mod+Shift+e exec ~/.config/i3/power-menu.sh

# Custom key bindings for audio and brightness control.
bindsym XF86AudioMute exec amixer -D pulse set Master 1+ toggle
bindsym XF86AudioLowerVolume exec amixer sset 'Master' 5%-
bindsym XF86AudioRaiseVolume exec amixer sset 'Master' 5%+
bindsym XF86MonBrightnessUp exec brightnessctl set +10%
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-

# Suspend the system with $mod+Shift+period.
bindsym $mod+Shift+period exec systemctl suspend

# Screenshot shortcuts.
bindsym Print exec --no-startup-id maim "$HOME/Pictures/screenshot_$(date +%Y%m%d_%H%M%S).png"
bindsym $mod+Print exec --no-startup-id maim --window $(xdotool getactivewindow) "$HOME/Pictures/screenshot_$(date +%Y%m%d_%H%M%S).png"
bindsym Shift+Print exec --no-startup-id maim --select "$HOME/Pictures/screenshot_$(date +%Y%m%d_%H%M%S).png"
bindsym Ctrl+Print exec --no-startup-id maim | xclip -selection clipboard -t image/png
bindsym Ctrl+$mod+Print exec --no-startup-id maim --window $(xdotool getactivewindow) | xclip -selection clipboard -t image/png
bindsym Ctrl+Shift+Print exec --no-startup-id maim --select | xclip -selection clipboard -t image/png

# Set up screen layout and wallpaper.
exec --no-startup-id $HOME/.config/i3/startup.sh
exec --no-startup-id picom --config ~/.config/picom.conf
exec_always --no-startup-id $HOME/.local/bin/keyboard-layout-listener.sh
exec --no-startup-id $HOME/Applications/Nextcloud.AppImage
exec --no-startup-id ~/.config/i3/touchpad.sh
