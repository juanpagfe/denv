#!/bin/bash
set -euo pipefail

usage() {
    echo -e "Tool to get the local and public IP address per network interface. You can choose the NIC as well giving it as an argument\n"
    echo "Usage: $0 [options] <network-interface-name>"
    echo "Options:"
    echo "  -h, --help      Show this help message"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) echo "Unknown option: $1" >&2; usage; exit 1 ;;
        *)  break ;;
    esac
    shift
done

NICS=("$@")
wargs=false
if [[ ${#NICS[@]} -gt 0 ]]; then
    wargs=true
else
    NICS=($(ip addr list | awk -F': ' '/^[0-9]/ {print $2}'))
fi

first=true
for nic in "${NICS[@]}"; do
    if [[ "$nic" == "lo" ]]; then
        continue
    fi

    ip=$(ip -4 addr show "$nic" 2>/dev/null | grep -oP '(?<=inet ).*(?=/)') || true
    if [[ -n "$ip" ]]; then
        pubip=$(curl --interface "$nic" -s --max-time 5 ipinfo.io/ip 2>/dev/null) || pubip="N/A"
        if [ "$first" = true ]; then
            first=false
            echo "------------------------------------"
        fi
        printf "Network Interface: %s\nLocal IP: %s\nPublic IP: %s\n" "$nic" "$ip" "$pubip"
        echo "------------------------------------"
    else
        if $wargs; then
            echo "The network interface '$nic' does not have a local ip address or does not exist." >&2
            exit 1
        fi
    fi
done
